// .env.example
DATABASE_URL=postgres://user:password@localhost:5432/events_db
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# Stripe Configuration
# IMPORTANTE: En producción usar Restricted API Key (rk_live_...) no secret key (sk_live_...)
STRIPE_SECRET_KEY=rk_test_...  # Restricted API Key de test mode
STRIPE_PUBLISHABLE_KEY=pk_test_...  # Publishable key para frontend
STRIPE_WEBHOOK_SECRET=whsec_...  # Webhook signing secret

# Frontend URL (para return_url de Checkout)
FRONTEND_URL=http://localhost:5173

PORT=3000
NODE_ENV=development